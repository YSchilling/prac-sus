tools/.prometheus
__pycache__/
.venv/

# Prometheus rewrites these whenever tools/prom.sh serves a snapshot
snapshots/*/tsdb/lock
snapshots/*/tsdb/queries.active
snapshots/*/tsdb/wal/
snapshots/*/tsdb/chunks_head/

# tools/prom.sh output when python/labdata.py serves a snapshot
snapshots/*/.prom.log
